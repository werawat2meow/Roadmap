generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public"]
}

model RmUserAccess {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                 @map("employee_id") @db.Uuid
  role            String                 @default("ยังไม่กำหนด")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  employees       employees              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  menuPermissions RmUserMenuPermission[]

  @@map("rm_user_access")
  @@schema("public")
}

model RmUserMenuPermission {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAccessId String       @map("user_access_id") @db.Uuid
  menuName     String       @map("menu_name")
  isAllowed    Boolean      @default(true) @map("is_allowed")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userAccess   RmUserAccess @relation(fields: [userAccessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userAccessId, menuName])
  @@map("rm_user_menu_permissions")
  @@schema("public")
}

model RmEvaluationType {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String         @unique
  name        String
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  categories  RmCategory[]
  evaluations RmEvaluation[]

  @@map("rm_evaluation_types")
  @@schema("public")
}

model RmCategory {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  evaluationTypeId String           @map("evaluation_type_id") @db.Uuid
  level            String
  sortOrder        Int              @default(0)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  departmentId     String?          @map("department_id") @db.Uuid
  divisionId       String?          @map("division_id") @db.Uuid
  unitId           String?          @map("unit_id") @db.Uuid
  evaluationType   RmEvaluationType @relation(fields: [evaluationTypeId], references: [id])
  items            RmCategoryItem[]

  @@map("rm_categories")
  @@schema("public")
}

model RmCategoryItem {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String                      @map("category_id") @db.Uuid
  topic          String
  weight         Int
  sortOrder      Int                         @default(0)
  isActive       Boolean                     @default(true)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  category       RmCategory                  @relation(fields: [categoryId], references: [id])
  reviewerScores RmEvaluationReviewerScore[]
  scores         RmEvaluationScore[]

  @@map("rm_category_items")
  @@schema("public")
}

model RmEvaluation {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId           String                 @map("employee_id") @db.Uuid
  evaluatorId          String                 @map("evaluator_id") @db.Uuid
  evaluationTypeId     String                 @map("evaluation_type_id") @db.Uuid
  status               String                 @default("Draft")
  quarter              String?
  companyScore         Float?
  departmentScore      Float?
  expectationScore     Float?
  totalScore           Float?
  grade                String?
  currentSalary        Float?
  newSalary            Float?
  newDesignation       String?
  newLevel             String?
  managerComment       String?
  employeeAcknowledged Boolean                @default(false)
  completedAt          DateTime?
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  examScore            Float?
  maxScore             Float?
  extra_data           Json?
  reviewers            RmEvaluationReviewer[]
  scores               RmEvaluationScore[]
  evaluationType       RmEvaluationType       @relation(fields: [evaluationTypeId], references: [id])

  @@map("rm_evaluations")
  @@schema("public")
}

model RmEvaluationScore {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evaluationId   String         @map("evaluation_id") @db.Uuid
  categoryItemId String         @map("category_item_id") @db.Uuid
  isIncluded     Boolean        @default(true) @map("is_included")
  score          Int
  remark         String?
  categoryItem   RmCategoryItem @relation(fields: [categoryItemId], references: [id])
  evaluation     RmEvaluation   @relation(fields: [evaluationId], references: [id])

  @@unique([evaluationId, categoryItemId])
  @@map("rm_evaluation_scores")
  @@schema("public")
}

model RmEvaluationReviewer {
  id           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evaluationId String                      @map("evaluation_id") @db.Uuid
  managerId    String                      @map("manager_id") @db.Uuid
  status       String                      @default("Pending")
  comment      String?
  completedAt  DateTime?
  createdAt    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  scores       RmEvaluationReviewerScore[]
  evaluation   RmEvaluation                @relation(fields: [evaluationId], references: [id])
  manager      employees                   @relation(fields: [managerId], references: [id])

  @@unique([evaluationId, managerId])
  @@map("rm_evaluation_reviewers")
  @@schema("public")
}

model RmEvaluationReviewerScore {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewerId     String               @map("reviewer_id") @db.Uuid
  categoryItemId String               @map("category_item_id") @db.Uuid
  score          Int
  remark         String?
  categoryItem   RmCategoryItem       @relation(fields: [categoryItemId], references: [id])
  reviewer       RmEvaluationReviewer @relation(fields: [reviewerId], references: [id])

  @@unique([reviewerId, categoryItemId])
  @@map("rm_evaluation_reviewer_scores")
  @@schema("public")
}

